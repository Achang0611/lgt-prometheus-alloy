# Grafana admin (change in production / Coolify secrets)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Public URL used by Grafana (must match reverse-proxy URL)
GRAFANA_ROOT_URL=https://grafana.example.com

# OTLP Basic Auth tenants: tenant:password pairs (comma-separated).
# Username becomes the forced resource attribute "tenant".
# Example: acme:secret1,beta:secret2
OTLP_TENANTS=acme:change-me-acme
