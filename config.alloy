// OTLP gateway: apps → Alloy (Basic Auth) → Prometheus / Loki / Tempo
// Basic Auth username (from OTLP_TENANTS) is forced as resource attribute "tenant".

otelcol.auth.basic "otlp" {
  htpasswd {
    file = sys.env("OTLP_HTPASSWD_FILE")
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint         = "0.0.0.0:4317"
    include_metadata = true
    auth             = otelcol.auth.basic.otlp.handler
  }
  http {
    endpoint         = "0.0.0.0:4318"
    include_metadata = true
    auth             = otelcol.auth.basic.otlp.handler
  }

  output {
    metrics = [otelcol.processor.attributes.tenant.input]
    logs    = [otelcol.processor.attributes.tenant.input]
    traces  = [otelcol.processor.attributes.tenant.input]
  }
}

// Upsert tenant from Basic Auth username (overwrites client-supplied tenant).
otelcol.processor.attributes "tenant" {
  action {
    key          = "tenant"
    action       = "upsert"
    from_context = "auth.username"
  }

  output {
    metrics = [otelcol.processor.transform.tenant_resource.input]
    logs    = [otelcol.processor.transform.tenant_resource.input]
    traces  = [otelcol.processor.transform.tenant_resource.input]
  }
}

// Promote signal attribute tenant → resource attribute (labels for Prom/Loki/Tempo).
otelcol.processor.transform "tenant_resource" {
  error_mode = "ignore"

  metric_statements {
    context = "datapoint"
    statements = [
      `set(resource.attributes["tenant"], datapoint.attributes["tenant"]) where datapoint.attributes["tenant"] != nil`,
    ]
  }

  log_statements {
    context = "log"
    statements = [
      `set(resource.attributes["tenant"], log.attributes["tenant"]) where log.attributes["tenant"] != nil`,
    ]
  }

  trace_statements {
    context = "span"
    statements = [
      `set(resource.attributes["tenant"], span.attributes["tenant"]) where span.attributes["tenant"] != nil`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Metrics → Prometheus remote write
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Logs → Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Traces → Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
